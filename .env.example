APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=museum_rag
POSTGRES_USER=museum
POSTGRES_PASSWORD=museum
DATABASE_URL=postgresql+asyncpg://museum:museum@postgres:5432/museum_rag

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=museum_chunks

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock

GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_AUTHORIZATION_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_EMBEDDING_MODEL=Embeddings
GIGACHAT_VERIFY_SSL=true

OPENAI_COMPATIBLE_API_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=deepseek-chat

EMBEDDING_MODEL_NAME=mock-embedding
# For mock provider use 384. For GigaChat Embeddings set the real model dimension.
# Common setup: Embeddings/Embeddings-2 usually use 1024; EmbeddingsGigaR uses 2560.
EMBEDDING_DIMENSION=384
EMBEDDING_VERSION=v1

CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100

RETRIEVAL_TOP_K=10
RETRIEVAL_MIN_SCORE=0.35
ANSWER_CONFIDENCE_THRESHOLD=0.45

STORE_LLM_PROMPTS=true
STORE_LLM_RAW_RESPONSES=true
